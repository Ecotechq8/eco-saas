<templates>
    <t t-name="account_financial_reports.ReportPreview">
        <div class="o_fr_wrapper" style="background: #f8f9fa; height: 100vh; overflow: auto;">
            <div class="o_fr_toolbar p-3 bg-dark text-white d-flex justify-content-between align-items-center sticky-top">
                <div>
                    <h5 class="m-0" t-esc="state.options.report_type.replace('_',' ').toUpperCase()"/>
                    <small t-esc="periodLabel"/>
                </div>
                <button class="btn btn-success" t-on-click="exportXlsx">Export to Excel</button>
            </div>

            <div class="o_fr_content p-4" t-if="state.data">

                <!-- Matrix Style (BS / P&L) -->
                <table t-if="state.data.sections" class="table table-sm table-bordered bg-white shadow-sm">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th style="width:100px">Code</th>
                            <th>Account</th>
                            <t t-foreach="state.data.columns" t-as="col" t-key="col">
                                <th class="text-end">
                                    <t t-esc="col"/>
                                </th>
                            </t>
                            <th class="text-end">Total Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.data.sections" t-as="sec" t-key="sec_item.label">
                            <tr class="table-primary font-weight-bold">
                                <td t-att-colspan="3 + state.data.columns.length">
                                    <t t-esc="sec_item.label.toUpperCase()"/>
                                </td>
                            </tr>
                            <tr t-foreach="sec_item.rows" t-as="row" t-key="row.code">
                                <td>
                                    <t t-esc="row.code"/>
                                </td>
                                <td>
                                    <t t-esc="row.name"/>
                                </td>
                                <td t-foreach="state.data.columns" t-as="c" t-key="c" class="text-end">
                                    <t t-esc="fmt(row.col_balances[c])"/>
                                </td>
                                <td class="text-end font-weight-bold">
                                    <t t-esc="fmt(row.total)"/>
                                </td>
                            </tr>
                            <tr class="table-info font-weight-bold">
                                <td colspan="2">TOTAL
                                    <t t-esc="sec_item.label.toUpperCase()"/>
                                </td>
                                <td t-foreach="state.data.columns" t-as="c" t-key="c" class="text-end">
                                    <t t-esc="fmt(sec_item.totals[c])"/>
                                </td>
                                <td class="text-end">
                                    <t t-esc="fmt(sec_item.total)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- General Ledger Style -->
                <table t-if="state.data.accounts" class="table table-sm table-bordered bg-white shadow-sm">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>Date</th>
                            <th>Entry</th>
                            <th>Label</th>
                            <th>Partner</th>
                            <th>Journal</th>
                            <th class="text-end">Debit</th>
                            <th class="text-end">Credit</th>
                            <th class="text-end">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.data.accounts" t-as="acc" t-key="acc.account_code">
                            <tr class="table-secondary font-weight-bold">
                                <td colspan="5">
                                    <t t-esc="acc.account_code"/>
                                    <t t-esc="acc.account_name"/>
                                </td>
                                <td class="text-end">
                                    <t t-esc="fmt(acc.total_debit)"/>
                                </td>
                                <td class="text-end">
                                    <t t-esc="fmt(acc.total_credit)"/>
                                </td>
                                <td class="text-end">
                                    <t t-esc="fmt(acc.total_balance)"/>
                                </td>
                            </tr>
                            <tr t-foreach="acc.lines" t-as="line" t-key="line.move_name">
                                <td>
                                    <t t-esc="line.date"/>
                                </td>
                                <td>
                                    <t t-esc="line.move_name"/>
                                </td>
                                <td>
                                    <t t-esc="line.label"/>
                                </td>
                                <td>
                                    <t t-esc="line.partner"/>
                                </td>
                                <td>
                                    <t t-esc="line.journal"/>
                                </td>
                                <td class="text-end">
                                    <t t-esc="fmt(line.debit)"/>
                                </td>
                                <td class="text-end">
                                    <t t-esc="fmt(line.credit)"/>
                                </td>
                                <td class="text-end">
                                    <t t-esc="fmt(line.balance)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </div>
    </t>
</templates>