<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="financial_report_wizard_form" model="ir.ui.view">
        <field name="name">financial.report.wizard.form</field>
        <field name="model">financial.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Financial Reports">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="report_type" widget="radio" options="{'horizontal': true}"/>
                        </h1>
                    </div>

                    <group string="Date Range">
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group string="Filters">
                        <group>
                            <field name="journal_ids"
                                   widget="many2many_tags"
                                   placeholder="All Journals…"/>
                        </group>
                        <group>
                            <field name="analytic_account_ids"
                                   widget="many2many_tags"
                                   placeholder="All Analytic Accounts…"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button name="action_view_report"
                            string="View Report"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions for each report type (pre-set report_type default) -->
    <record id="action_general_ledger_wizard" model="ir.actions.act_window">
        <field name="name">General Ledger</field>
        <field name="res_model">financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'general_ledger'}</field>
    </record>

    <record id="action_trial_balance_wizard" model="ir.actions.act_window">
        <field name="name">Trial Balance</field>
        <field name="res_model">financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'trial_balance'}</field>
    </record>

    <record id="action_balance_sheet_wizard" model="ir.actions.act_window">
        <field name="name">Balance Sheet</field>
        <field name="res_model">financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'balance_sheet'}</field>
    </record>

    <record id="action_profit_loss_wizard" model="ir.actions.act_window">
        <field name="name">Profit &amp; Loss</field>
        <field name="res_model">financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'profit_loss'}</field>
    </record>

</odoo>
