<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="modify_checkin_time" model="ir.actions.server">
        <field name="name">Modify Check-in Time</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_modify_checkin_time()
        </field>
    </record>

    <record id="action_confirm_attendance" model="ir.actions.server">
        <field name="name">Confirm</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('eco_hr_attendance_custom.group_attendance_confirmation_actions'))]"/>
        <field name="state">code</field>
        <field name="code">
            action = records.action_confirm_attendance()
        </field>
    </record>

    <record id="action_set_attendance_to_draft" model="ir.actions.server">
        <field name="name">Set to Draft</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('eco_hr_attendance_custom.group_attendance_confirmation_actions'))]"/>
        <field name="state">code</field>
        <field name="code">
            action = records.action_set_attendance_to_draft()
        </field>
    </record>

    <record id="action_export_attendance_pdf" model="ir.actions.server">
        <field name="name">Export Attendance PDF</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_export_attendance_pdf()
        </field>
    </record>
</odoo>
