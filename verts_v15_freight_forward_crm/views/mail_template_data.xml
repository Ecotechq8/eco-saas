<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_for_ff_price_request" model="mail.template">
            <field name="name">FF Price Request Mail</field>
            <field name="model_id" ref="verts_v15_freight_forward_crm.model_crm_lead"/>
            <field name="subject">${object.company_id.name} Opportunity (Ref ${object.name or 'n/a' })</field>
            <field name="partner_to"></field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear Sir/Madam,
        <br/><br/>
        Here is in attachment a Opportunity <strong>${object.code}</strong> - <strong>${object.name}</strong>
        from ${object.company_id.name}.
        <br/><br/>
    </p>
</div></field>
            <field name="report_template" ref="opportunity_price_request_report_id"/>
            <field name="report_name">OPP_${(object.name or '').replace('/','_')}</field>
            <field name="lang">${object.partner_id.lang}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
