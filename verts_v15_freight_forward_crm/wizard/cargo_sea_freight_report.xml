<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cargo_sea_freight_report_wizard" model="ir.ui.view">
        <field name="name">cargo.sea.freight.report.wizard</field>
        <field name="model">cargo.sea.freight.report</field>
        <field name="arch" type="xml">
            <form string="Cargo Sea Freight Report">
                <group>
                    <field name="date_from" required="1"/>
                    <field name="date_to" required="1"/>
                    <field name="currency_type" widget="selection"/>
                </group>
                <footer>
                    <button string="Generate Excel" type="object" name="generate_excel_report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cargo_sea_freight_report_wizard" model="ir.actions.act_window">
        <field name="name">Cargo Sea Freight Report</field>
        <field name="res_model">cargo.sea.freight.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>