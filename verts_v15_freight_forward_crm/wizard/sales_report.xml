<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_cargo_sales_report_wizard" model="ir.ui.view">
        <field name="name">cargo.sales.report.wizard.form</field>
        <field name="model">cargo.sales.report</field>
        <field name="arch" type="xml">
            <form string="Cargo Sales Report">
<!--                <group>-->
<!--                    <field name="date_from" required="1"/>-->
<!--                    <field name="date_to" required="1"/>-->
<!--                    <field name="currency_type" required="1"/>-->
<!--                </group>-->
                <footer>
                    <button string="Generate Excel Report" type="object" name="generate_excel_report"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cargo_sales_report_wizard" model="ir.actions.act_window">
        <field name="name">Cargo Sales Report</field>
        <field name="res_model">cargo.sales.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>