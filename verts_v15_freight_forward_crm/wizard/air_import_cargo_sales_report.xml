<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Wizard Form View -->

    <record id="view_air_import_cargo_sales_report_wizard" model="ir.ui.view">
        <field name="name">air.import.cargo.sales.report.wizard</field>
        <field name="model">air.import.cargo.sales.report</field>
        <field name="arch" type="xml">
            <form string="Air Import Cargo Sales Report">
<!--                <group>-->
<!--                    <field name="date_from" required="1"/>-->
<!--                    <field name="date_to" required="1"/>-->
<!--                    <field name="currency_type" widget="selection"/>-->
<!--                </group>-->
                <footer>
                    <button string="Generate Excel" type="object" name="generate_excel_report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_air_import_cargo_sales_report_wizard" model="ir.actions.act_window">
        <field name="name">Air Import Cargo Sales Report</field>
        <field name="res_model">air.import.cargo.sales.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
