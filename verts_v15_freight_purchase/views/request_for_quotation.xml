<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <data>
    <!-- Please do not use this file in future. It's use only for RFQ -->
    <!-- Purchase Order Line -->
    <record id="purchase_order_line_tree_inherit" model="ir.ui.view">
      <field name="name">purchase.order.line.tree</field>
      <field name="model">purchase.order.line</field>
      <field name="arch" type="xml">
        <list string="Purchase Order Lines" create="false">
          <field name="order_id"/>
          <field name="name"/>
          <field name="partner_id" string="Vendor"/>
          <field name="product_id"/>
          <field name="price_unit"/>
          <field name="product_qty"/>
          <field name="product_uom" groups="uom.group_uom"/>
          <field name="price_subtotal" widget="monetary"/>
          <field name="date_planned" widget="date"/>
          <field name="status"/>
          <button name="%(action_view_wiz_change_pol_qty)d" type="action" string="Change Qty" class="oe_highlight"/>
          <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"/>
          <button name="action_cancel" string="Cancel" type="object" class="oe_highlight"/>
        </list>
      </field>
    </record>
    <!-- Please do not use this file in future. It's use only for RFQ -->
    <record id="purchase_order_line_search_inherit" model="ir.ui.view">
      <field name="name">purchase.order.line.search</field>
      <field name="model">purchase.order.line</field>
      <field name="arch" type="xml">
        <search string="Search Purchase Order">
          <field name="order_id"/>
          <field name="product_id"/>
          <field name="partner_id" string="Vendor" filter_domain="[('partner_id', 'child_of', self)]"/>
          <filter name="hide_cancelled" string="Hide cancelled lines" domain="[('state', '!=', 'cancel')]"/>
          <group expand="0" string="Group By">
            <filter name="groupby_supplier" string="Vendor" domain="[]" context="{'group_by' : 'partner_id'}"/>
            <filter name="groupby_product" string="Product" domain="[]" context="{'group_by' : 'product_id'}"/>
            <filter string="Order Reference" name="order_reference" domain="[]" context="{'group_by' :'order_id'}"/>
            <filter string="Status" name="status" domain="[]" context="{'group_by' : 'state'}"/>
          </group>
        </search>
      </field>
    </record>
    <record id="purchase_line_form_action" model="ir.actions.act_window">
      <field name="name">Purchase Order Line</field>
      <!--	    <field name="type">ir.actions.act_window</field>-->
      <field name="res_model">purchase.order.line</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="purchase_order_line_search_inherit"/>
      <field name="view_id" ref="purchase_order_line_tree_inherit"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
	        Purchase Order Line
	      </p>
        <p>
	        It will be converted into a purchase order Line.
	      </p>
      </field>
    </record>
    <!-- Purchase Orders Action -->
    <record model="ir.actions.act_window" id="action_request_for_quot_to_so">
      <field name="name">Request for Quotation</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">purchase.order</field>
      <field name="view_mode">form,list</field>
      <field name="domain">[('req_quot_id','=',active_id)]</field>
      <field name="context">{"default_req_quot_id":active_id}</field>
    </record>
    <record model="ir.actions.act_window" id="action_request_for_quot_list">
      <field name="name">Request for Quotations</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">purchase.order</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('req_quot_id','=',active_id)]</field>
      <field name="context">{"default_req_quot_id":active_id}</field>
    </record>
    <!--        New Rfq form view-->
    <record model="ir.ui.view" id="view_new_rfq_request_for_quotation_form">
      <field name="name">request.for.quotation.form</field>
      <field name="model">request.for.quotation</field>
      <field name="arch" type="xml">
        <form string="Request For Quotation">
          <header>
            <button name="action_rfq_send" string="Send RFQ by Email" type="object" context="{'send_rfq':False}" invisible="state not in ('draft', 'open', 'ongoing')"/>
            <button name="rais_new_quote" string="New Quotation" type="object" class="btn-primary"/>
            <button name="rais_new_quote" string="New Quotation" type="object"/>
            <button name="action_in_progress" string="Confirm" type="object" class="btn-primary" invisible="state not in ('draft')"/>
            <button name="action_open" string="Close For Bid" type="object" class="btn-primary" invisible="state not in ('in_progress')"/>
            <button name="action_compare_quotation" string="Compare Quotation" type="object" class="btn-primary" invisible="state not in ('open', 'ongoing')"/>
            <button name="action_draft" string="Reset to Draft" type="object" invisible="state not in ('cancel')"/>
            <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'in_progress', 'ongoing')"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,open,done"/>
            <!-- attrs="{'invisible': [('is_quantity_copy', '=', 'none')]}" -->
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="%(action_request_for_quot_list)d" type="action" class="oe_stat_button" icon="fa-list-alt">
                <field name="order_count" widget="statinfo" string="RFQs/Orders"/>
              </button>
            </div>
            <div class="float-left">
              <label for="name" class="oe_edit_only oe_inline"/>
              <h1>
                <field name="name"/>
              </h1>
            </div>
            <group>
              <group>
                <!-- <field name="is_quantity_copy" invisible='1'/> -->
                <field name="user_id"/>
                <!-- <field name="type_id" attrs="{'readonly': [('state','!=','draft')]}" widget="selection"/> -->
                <field name="vendor_id" invisible="1" context="{'search_default_supplier':1, 'default_supplier':1, 'default_customer':0}"/>
                <!-- attrs="{'required': [('is_quantity_copy', '=', 'none')], 'readonly': [('state', 'in', ['ongoing','done'])]}" -->
                <field name="partner_ids" widget="many2many_tags" context="{'search_default_supplier':1, 'default_supplier':1, 'default_customer':0}"/>
                <!-- attrs="{'required': [('is_quantity_copy', '=', 'none')], 'readonly': [('state', 'in', ['ongoing','done'])]}" -->
                <field name="currency_id" groups="base.group_multi_currency"/>
                <field name="warehouse_id" groups="stock.group_stock_multi_warehouses" required="1"/>
                <field name="internal_product_type"/>
                <field name="remarks"/>
              </group>
              <group>
                <field name="date_end"/>
                <field name="ordering_date"/>
                <field name="schedule_date"/>
                <field name="origin" placeholder="e.g. PO0025"/>
                <!-- <field name="picking_type_id" widget="selection" groups="stock.group_adv_location" attrs="{'readonly': [('state', '!=', 'draft')]}"/> -->
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                <!--                    	<field name="requsition_ids" widget="many2many_tags" domain="[('state','=','approved')]" attrs="{'readonly': [('state','not in',('draft','in_progress','open','ongoing'))]}"/>-->
              </group>
              <!--                    <separator string="Advance Payment"/>-->
              <group>
                <field name="advance_type" invisible="1"/>
                <field name="advance_value" invisible="1"/>
                <field name="advance_remark" invisible="1"/>
                <field name="used_for_readonly" invisible="1"/>
              </group>
            </group>
            <notebook>
              <page string="Products">
                <field name="line_ids" widget="section_and_note_one2many">
                  <list string="Products" editable="bottom">
                    <control>
                      <create string="Add a Line"/>
                      <create string="Add a section" context="{'default_display_type': 'line_section'}"/>
                      <create string="Add a note" context="{'default_display_type': 'line_note'}"/>
                    </control>
                    <!--                                <field name="name" widget="section_and_note_text" string="." attrs="{'invisible':[('display_type', '=', False)]}"  />-->
                    <field name="display_type" invisible="1"/>
                    <field name="product_id"/>
                    <field name="product_qty" readonly="1"/>
                    <!-- <field name="qty_ordered"/> -->
                    <field name="product_uom_id" groups="uom.group_uom"/>
                    <field name="schedule_date" groups="base.group_no_one"/>
                    
                    
                    <field name="price_unit"/>
                  </list>
                  <form string="Products">
                    <group>
                      <field name="product_id"/>
                      <field name="product_qty"/>
                      <!-- <field name="qty_ordered"/> -->
                      <field name="product_uom_id"/>
                      <field name="schedule_date"/>
                      
                      <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                  </form>
                </field>
                <separator string="Associated Quotation"/>
                <field name="purchase_ids" options="{'reload_on_button': true}">
                  <list string="Purchase Order">
                    <field name="name" string="Reference"/>
                    <field name="date_order" string="Order Date"/>
                    <field name="partner_id"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    <field name="dest_address_id" groups="stock.group_stock_multi_locations"/>
                    <field name="date_planned" invisible="1"/>
                    <field name="origin"/>
                    <field name="state"/>
                    <!--  <button name="button_cancel" states="draft,sent,to approve,purchase" string="Cancel Purchase Order" type="object" icon="fa-times"/>
                                <button name="button_confirm" states="draft" string="Confirm Purchase Order" type="object" icon="fa-check"/>
                                <button name="button_approve" states="to approve" string="Approved by Vendor" type="object" icon="fa-check-square-o"/>
                                <button name="action_rfq_send" states="draft" string="Send RFQ by Email" type="object" context="{'send_rfq':True}" icon="fa-envelope-o"/>-->
                  </list>
                </field>
                <separator string="Terms and Conditions"/>
                <field name="description"/>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>
