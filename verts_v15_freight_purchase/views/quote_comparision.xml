<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_quote_comparision_form" model="ir.ui.view">
            <field name="name">quote.comparision.form</field>
            <field name="model">quote.comparision</field>
            <field name="arch" type="xml">
                <form string="Quote Comparision Form">
                    <header>
                        <button name="action_in_progress" string="Send For Approval" type="object"
                                class="btn-primary"/>
                        <!--                        <button name="action_in_approve" string="Approved" type="object"-->
                        <!--                                class="btn-primary"/>-->
                        <button name="create_po"
                                string="Create Po"
                                type="object"
                                class="btn-primary"/>
                        <button name="button_1st_approval" type="object"
                                invisible="state != 'pending_approval'"
                                string="1st Level Approval" class="oe_highlight"/>
                        <button name="button_2nd_approval" type="object"
                                invisible="state != 'to_approve'"
                                string="2nd Level Approval" class="oe_highlight"/>
                        <button name="button_3rd_approval" type="object"
                                invisible="state != 'second_level_approved'"
                                string="3rd Level Approval" class="oe_highlight"/>
                        <button name="button_4th_approval" type="object"
                                invisible="state != 'third_level_approved'"
                                string="4th Level Approval" class="oe_highlight"/>
                        <button name="button_5th_approval" type="object"
                                invisible="state != 'fourth_level_approved'"
                                string="5th Level Approval" class="oe_highlight"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="confirm_purchase_ids" type="object" class="oe_stat_button" icon="fa-list-alt">
                                <field name="po_order_count" widget="statinfo" string="Purchase Orders"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="create_uid"/>
                                <field name="create_date"/>
                                <field name="rfq_no" readonly="1"/>
                                <field name="internal_product_type" readonly="0"/>
                                <field name="remarks"/>
                                <field name="is_show_create_po" invisible="1"/>
                            </group>
                            <group>
                                <!--                               <separator string="Advance Payment"/>-->
                                <field name="advance_type" invisible="1"/>
                                <field name="advance_value" invisible="1"/>
                                <field name="advance_remark" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Quote Comparision Line">
                                <field name="rfq_no_line" widget="section_and_note_one2many">
                                    <list editable="bottom" decoration-success="color_change == True"
                                          default_order='product_id'>
                                        <control>
                                            <create string="Add a product"/>
                                            <create string="Add a section"
                                                    context="{'default_display_type': 'line_section'}"/>
                                            <create string="Add a note"
                                                    context="{'default_display_type': 'line_note'}"/>
                                        </control>
                                        <field name="display_type" invisible="1"/>
                                        <field name="initiate_po"/>
                                        <field name="product_id" readonly="0" force_save="1"/>
                                        <field name="partner_id" readonly="0" force_save="1"/>
                                        <field name="order_id" readonly="0"/>
                                        <!--                                        <field name="product_id" readonly="0" force_save="1" context="{'partner_id':parent.partner_id, 'quantity':product_qty,'uom':product_uom, 'company_id': parent.company_id}"/>-->
                                        <field name="uom_id" readonly="0"/>
                                        <field name="price_unit" readonly="0" force_save="1"/>
                                        <field name="rfq_qty" readonly="1" force_save="1"/>
                                        <field name="po_qty" readonly="0" force_save="1"/>
                                        <field name="date_planned" readonly="0" force_save="1"/>
                                        <field name="remarks"/>
                                        <field name="pending_rfq_qty" readonly="1" force_save="1" optional="show"/>
                                        <field name="done_rfq_qty" readonly="1" optional="show"/>
                                        <field name="color_change" invisible="1"/>
                                        <field name="name" widget="section_and_note_text" optional="show"
                                               invisible="1"/>
                                    </list>
                                    <form editable="bottom">
                                        <sheet>
                                            <field name="display_type" invisible="1"/>
                                            <group>
                                                <field name="initiate_po"/>
                                                <field name="product_id" readonly="0" force_save="1"/>
                                                <field name="partner_id" readonly="0" force_save="1"/>
                                                <field name="order_id" readonly="0"/>
                                                <field name="uom_id" readonly="0" force_save="1"/>
                                                <field name="price_unit" readonly="0" force_save="1"/>
                                                <field name="rfq_qty" readonly="1" force_save="1"/>
                                                <field name="po_qty" readonly="0" force_save="1"/>
                                                <field name="date_planned" readonly="0" force_save="1"/>
                                                <field name="remarks"/>
                                                <field name="pending_rfq_qty" readonly="1" force_save="1"/>
                                                <field name="done_rfq_qty" readonly="0" force_save="1"/>
                                                <field name="color_change" invisible="1"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id='view_tree_quote_comparision' model='ir.ui.view'>
            <field name="name">Quote Comparision</field>
            <field name="model">quote.comparision</field>
            <field name="arch" type="xml">
        <list>
                    <field name="name"/>
                    <field name="create_uid"/>
                    <field name="create_date"/>
                    <field name="remarks"/>
                </list>
            </field>
        </record>

        <!--Form Action -->
        <record id="view_quote_comparision_form_action" model="ir.actions.act_window">
            <field name="name">Quote Comparision</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">quote.comparision</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_purchase_rfq_in"
                  name="RFQs"
                  parent="purchase.menu_purchase_root"
                  sequence="20"/>
        <menuitem id="quote_comparision_id"
                  parent="menu_purchase_rfq_in"
                  action="view_quote_comparision_form_action"
                  name="Quote Comparison"
                  sequence="2"/>
    </data>
</odoo>
