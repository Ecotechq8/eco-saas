<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="warehouse_user_restrict" model="res.groups">
        <field name="name">Restrict Stock Warehouse Locations</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="restrict_stock_picking" model="ir.rule">
        <field name="name">Restrict Stock Picking</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">
            ['|',('location_id','in',user.allow_location_ids.ids),('location_dest_id','in',user.allow_location_ids.ids)]
        </field>
        <field name="groups" eval="[(4, ref('location_restriction_for_user.warehouse_user_restrict'))]"/>
    </record>
    <record id="restrict_stock_picking_type" model="ir.rule">
        <field name="name">Restrict Stock Picking Type</field>
        <field name="model_id" ref="stock.model_stock_picking_type"/>
        <field name="domain_force">
            ['|',('default_location_src_id','in',user.allow_location_ids.ids),('default_location_dest_id','in',user.allow_location_ids.ids)]
        </field>
        <field name="groups" eval="[(4, ref('location_restriction_for_user.warehouse_user_restrict'))]"/>
    </record>
    <record id="restrict_stock_warehouse" model="ir.rule">
        <field name="name">Restrict Stock Warehouse</field>
        <field name="model_id" ref="stock.model_stock_warehouse"/>
        <field name="domain_force">[('lot_stock_id','in',user.allow_location_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('location_restriction_for_user.warehouse_user_restrict'))]"/>
    </record>

    <record id="restrict_stock_location" model="ir.rule">
        <field name="name">Restrict Stock Location</field>
        <field name="model_id" ref="stock.model_stock_location"/>
        <field name="domain_force">['|', ('id','in',user.allow_location_ids.ids), ('location_id', 'not in',
            user.allow_location_ids.ids)]
        </field>
        <field name="groups" eval="[(4, ref('location_restriction_for_user.warehouse_user_restrict'))]"/>
    </record>

    <record id="stock_picking_rule_users" model="ir.rule">
        <field name="name">Restrict Warehouse Transfers</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">['|', ('location_id','in', user.allow_location_ids.ids), ('location_dest_id', 'in'
            , user.allow_location_ids.ids)]
        </field>
        <field name="groups" eval="[(4, ref('location_restriction_for_user.warehouse_user_restrict'))]"/>
    </record>

</odoo>