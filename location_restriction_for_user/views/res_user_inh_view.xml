<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="user_restrict" model="ir.ui.view">
        <field name="name">Users</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='account_security']" position="after">
                <page name="allowed_warehouses" string="Allowed Locations">
                    <group>
                        <field name="allow_location_ids" string="Allowed Location" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_users_view_form_inventory_dashboard_warehouses" model="ir.ui.view">
        <field name="name">res.users.form.inventory.dashboard.warehouses</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="sale_stock.res_users_view_form"/>
        <field name="arch" type="xml">
            <field name="property_warehouse_id" position="after">
                <field name="inventory_dashboard_warehouse_ids"
                       widget="many2many_tags"
                       groups="stock.group_stock_multi_warehouses"/>
            </field>
        </field>
    </record>
</odoo>





