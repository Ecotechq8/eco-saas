<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="res.users" id="base.user_admin">
            <field name="is_user_profile" eval="True"/>
        </record>
        <record id="admin_user_partner_id" model="res.partner">
            <field name="name">Admin Profile</field>
            <field name="company_id" eval="None"/>
            <field name="active" eval="True"/>
        </record>
        <record id="admin_user_profile_id" model="res.users">
            <field name="name">Admin Profile</field>
            <field name="login">Admin Profile</field>
            <field name="is_user_profile" eval="True"/>
            <field name="partner_id" ref="admin_user_partner_id"/>
            <field name="groups_id" eval="[(4,ref('base.group_system')),(4,ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
