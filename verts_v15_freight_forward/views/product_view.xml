<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <data>
    <record id="product_uom_form_view_inherit_ff" model="ir.ui.view">
      <field name="name">uom.uom.form</field>
      <field name="model">uom.uom</field>
      <field name="inherit_id" ref="uom.product_uom_form_view"/>
      <field name="arch" type="xml">
        <field name="rounding" position="after">
          <field name="freight_forward_forms"/>
        </field>
      </field>
    </record>
    <record id="product_template_form_view_inherit12_expo" model="ir.ui.view">
      <field name="name">product.template.common.form</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_only_form_view"/>
      <field name="arch" type="xml">
        <field name="barcode" position="after">
          <field name="export_pro_categ_id" options="{'no_create': True,'no_open': True}"/>
          <field name="charge_code"/>
        </field>
        <xpath expr="//div[@name='options']" position="inside">
          <div>
            <field name="is_export_expense" readonly="1"/>
            <label for="is_export_expense"/>
          </div>
          <div>
            <field name="is_standard_expense"/>
            <label for="is_standard_expense"/>
          </div>
        </xpath>
      </field>
    </record>
    <record id="action_export_expense_tree" model="ir.actions.act_window">
      <field name="name">Export Expense</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">product.template</field>
      <field name="view_mode">kanban,list,form</field>
      <field name="view_id" ref="product.product_template_kanban_view"/>
      <field name="search_view_id" ref="product.product_template_search_view"/>
      <field name="domain">[('is_export_expense','=',True)]</field>
      <field name="context">{'default_is_export_expense':1}</field>
    </record>
    <record model="ir.actions.act_window.view" id="action_product_template_export_expense_kanban_view_users_kanban">
      <field name="sequence" eval="1"/>
      <field name="view_mode">kanban</field>
      <field name="view_id" ref="product.product_template_kanban_view"/>
      <field name="act_window_id" ref="action_export_expense_tree"/>
    </record>
    <record model="ir.actions.act_window.view" id="action_product_template_export_expense_form_view_users_form">
      <field name="sequence" eval="3"/>
      <field name="view_mode">form</field>
      <field name="view_id" ref="product.product_template_only_form_view"/>
      <field name="act_window_id" ref="action_export_expense_tree"/>
    </record>
    <record model="ir.actions.act_window.view" id="action_product_template_export_expense_form_view_users_tree">
      <field name="sequence" eval="2"/>
      <field name="view_mode">list</field>
      <field name="view_id" ref="product.product_template_tree_view"/>
      <field name="act_window_id" ref="action_export_expense_tree"/>
    </record>
    <record id="product_template_action_inherit_export" model="ir.actions.act_window">
      <field name="name">Products</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">product.template</field>
      <field name="view_mode">kanban,list,form,activity</field>
      <field name="view_id" ref="product.product_template_kanban_view"/>
      <field name="search_view_id" ref="product.product_template_search_view"/>
      <field name="domain">[('is_export','=',True)]</field>
      <field name="context">{'default_is_export':1}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
                    Create a new product
                </p>
        <p>
                    You must define a product for everything you purchase,
                    whether it's a physical product, a consumable or services.
                </p>
      </field>
    </record>
  </data>
</odoo>
