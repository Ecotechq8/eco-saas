<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <data>
    <!-- Export Party Master -->
    <record id="view_res_partner_form_export_inherit" model="ir.ui.view">
      <field name="name">res.partner.form</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="arch" type="xml">
        <field name="company_type" position="before">
          <h1>
            <field name="code" required="1" readonly="1"/>
          </h1>
        </field>
        <xpath expr="/form/sheet/group[1]" position="before">
          <group col="4" colspan="4">
            <field name="party_full_name"/>
          </group>
        </xpath>
        <xpath expr="//field[@name='type']" position="before">
          <field name="is_agent" invisible="1"/>
          <field name="is_export_partner" invisible="1"/>
          <field name="is_shipping_line" invisible="1"/>
          <field name="is_cha" invisible="1"/>
        </xpath>
        <xpath expr="//field[@name='category_id']" position="after">
          <field name="airline_code"/>
          <field name="airline_no"/>
        </xpath>
      </field>
    </record>
    <!--        partner pro module not found in dependency-->
    <!--        <record id="view_partner_form_in321_export" model="ir.ui.view">-->
    <!--            <field name="name">res.partner.form</field>-->
    <!--            <field name="model">res.partner</field>-->
    <!--            <field name="inherit_id" ref="verts_v15_partner_pro.view_partner_form_in321" />-->
    <!--			<field name="arch" type="xml">-->
    <!--                <xpath expr="//field[@name='domestic_gid']" position="attributes">-->
    <!--					<attribute name="attrs">{'required': [('is_export_partner', '=',False)]}</attribute>-->
    <!--                </xpath>-->
    <!--                <xpath expr="//field[@name='international_gid']" position="attributes">-->
    <!--					<attribute name="attrs">{'required': [('is_export_partner', '=',True)]}</attribute>-->
    <!--				</xpath>-->
    <!--            </field>-->
    <!--        </record>-->
    <record id="action_export_res_partner_inherit" model="ir.actions.act_window">
      <field name="name">Export Partner</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('is_export_partner','=',1)]</field>
      <field name="context">{'default_is_export_partner':1, 'default_customer':1}</field>
      <!--<field name="view_id" ref="view_res_partner_form_export_inherit"/>-->
    </record>
    <record id="action_export_partner_tree" model="ir.actions.act_window.view">
      <field eval="1" name="sequence"/>
      <field name="view_mode">list</field>
      <field name="view_id" ref="base.view_partner_tree"/>
      <field name="act_window_id" ref="action_export_res_partner_inherit"/>
    </record>
    <record id="action_export_partner_form" model="ir.actions.act_window.view">
      <field eval="2" name="sequence"/>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_res_partner_form_export_inherit"/>
      <field name="act_window_id" ref="action_export_res_partner_inherit"/>
    </record>
    <record id="action_shippingline_res_partner_inherit" model="ir.actions.act_window">
      <field name="name">Shipping Line</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('is_shipping_line','=',1)]</field>
      <field name="context">{'default_is_shipping_line':1, 'default_customer':1}</field>
      <!--<field name="view_id" ref="view_res_partner_form_export_inherit"/>-->
    </record>
    <record id="action_shippingline_partner_tree" model="ir.actions.act_window.view">
      <field eval="1" name="sequence"/>
      <field name="view_mode">list</field>
      <field name="view_id" ref="base.view_partner_tree"/>
      <field name="act_window_id" ref="action_shippingline_res_partner_inherit"/>
    </record>
    <record id="action_shippingline_partner_form" model="ir.actions.act_window.view">
      <field eval="2" name="sequence"/>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_res_partner_form_export_inherit"/>
      <field name="act_window_id" ref="action_shippingline_res_partner_inherit"/>
    </record>
    <record id="action_is_airline" model="ir.actions.act_window">
      <field name="name">Airlines</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">res.partner</field>
      <!--			<field name="view_type">form</field>-->
      <field name="view_id" ref="base.view_partner_tree"/>
      <field name="view_mode">list,form</field>
      <field name="domain">[('is_airline','=',True),('customer_rank','&gt;',0)]</field>
      <field name="context">{'default_is_airline':1,'search_default_customer':1, 'default_customer_rank': 1,'default_is_company': True}</field>
    </record>
    <record id="action_cha_res_partner_inherit" model="ir.actions.act_window">
      <field name="name">CHA</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('is_cha','=',1)]</field>
      <field name="context">{'default_is_cha':1, 'default_customer':1}</field>
      <!--<field name="view_id" ref="view_res_partner_form_export_inherit"/>-->
    </record>
    <record id="action_cha_partner_tree" model="ir.actions.act_window.view">
      <field eval="1" name="sequence"/>
      <field name="view_mode">list</field>
      <field name="view_id" ref="base.view_partner_tree"/>
      <field name="act_window_id" ref="action_cha_res_partner_inherit"/>
    </record>
    <record id="action_export_cha_form" model="ir.actions.act_window.view">
      <field eval="2" name="sequence"/>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_res_partner_form_export_inherit"/>
      <field name="act_window_id" ref="action_cha_res_partner_inherit"/>
    </record>
    <!--Company view Inherit -->
    <record id="view_company_form_inherit_export" model="ir.ui.view">
      <field name="name">res.company.export.form</field>
      <field name="model">res.company</field>
      <field name="inherit_id" ref="base.view_company_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='email']" position="after">
          <field name="export_import_license_no"/>
        </xpath>
      </field>
    </record>
    <!--Company view Inherit -->
  </data>
</odoo>
