<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="inherit_view_account_payment_register_form_cheque_fields" model="ir.ui.view">
            <field name="name">account.payment.register.form.inherit.cheque</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_bank_id']" position="after">
                    <field name="is_cheque"/>
                    <field name="cheque_number" attrs="{'invisible': [('is_cheque', '=', False)]}"/>
                    <field name="cheque_date" attrs="{'invisible': [('is_cheque', '=', False)]}"/>
                    <field name="drawn_on" attrs="{'invisible': [('is_cheque', '=', False)]}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
