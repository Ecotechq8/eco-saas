<odoo>
  <data>
	  <record id="paperformat_sale_contract_report" model="report.paperformat">
            <field name="name">Sale Contract Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
	       <field name="margin_top">60</field>
            <field name="margin_bottom">25</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">55</field>
            <field name="dpi">90</field>
	  </record>

      <report
		id="action_sale_contract_report_view"
		string="Sales Contract Report"
		model="sale.order"
		report_type="qweb-pdf"
		name="verts_v15_freight_forward.report_of_sale_contract"
		file="verts_v15_freight_forward.report_of_sale_contract"
		print_report_name="'Print Sales Contract Report'"
		paperformat="verts_v15_freight_forward.paperformat_sale_contract_report"
	  />
   </data>
</odoo>