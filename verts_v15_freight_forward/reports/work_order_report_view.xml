<odoo>
  <data>
	    <record id="paperformat_export_work_order_report" model="report.paperformat">
            <field name="name">Export Work Order Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
	       <field name="margin_top">10</field>
            <field name="margin_bottom">28</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">55</field>
            <field name="dpi">90</field>
        </record>

      <report
		id="action_work_order_report_view"
		string="Work Order Report"
		model="sale.order"
		report_type="qweb-pdf"
		name="verts_v15_freight_forward.report_of_export_work_order"
		file="verts_v15_freight_forward.report_of_export_work_order"
		print_report_name="'Print Work Order Report'"
		paperformat="verts_v15_freight_forward.paperformat_export_work_order_report"
	  />
   </data>
</odoo>