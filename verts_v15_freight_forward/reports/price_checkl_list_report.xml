<odoo>
  <data>
	    <record id="paperformat_price_check_list_report" model="report.paperformat">
            <field name="name">Price Check List Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
	       <field name="margin_top">10</field>
            <field name="margin_bottom">25</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">55</field>
            <field name="dpi">90</field>
        </record>

      <report
		id="action_price_check_list_report_view"
		string="Price Check List Report"
		model="sale.order"
		report_type="qweb-pdf"
		name="verts_v15_freight_forward.report_of_price_check_list"
		file="verts_v15_freight_forward.report_of_price_check_list"
		print_report_name="'Print Price Check List Report'"
		paperformat="verts_v15_freight_forward.paperformat_price_check_list_report"
	  />
   </data>
</odoo>