<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_invoice_document_ff_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="header">
                    <table width="100%" border="0" cellspacing="0" cellpadding="0"
                           t-attf-style="margin:0; font-family: Arial,Helvetica, sans-serif; background:#fff;"
                           class="my-0 table table-sm table-borderless">
                        <tbody>
                            <tr>
                                <td valign="top" width="33%" align="left"
                                    style="color:#4D4D4F; font-size:12px; padding:
												0 0 0px 0; line-height:16px; padding-top:16px;">
                                    <img t-if="o.company_id.logo"
                                         t-attf-src="data:image/*;base64,{{o.company_id.logo}}"
                                         style="max-height: 80px;"/>
                                </td>
                                <td style="width: 33%; height: 49px; font-size: 50px;" align="center">

                                </td>
                                <td style="width: 33%; height: 49px; font-size: 11px; line-height: 15px;">
                                    <strong>
                                        <span t-field="o.company_id.name"/><br/>
                                        <span t-field="o.company_id.street"/><br/>
                                        <span t-if="o.company_id.street2" t-field="o.company_id.street2"/><br/>
                                        <span t-field="o.company_id.city"/>
                                        <span t-if="o.company_id.state_id">, <span t-field="o.company_id.state_id.name"/></span>
                                        <span t-if="o.company_id.country_id">, <span t-field="o.company_id.country_id.name"/></span><br/>
                                        <span t-if="o.company_id.phone">Tel: <span t-field="o.company_id.phone"/><br/></span>
                                        <span t-if="o.company_id.vat">VAT: <span t-field="o.company_id.vat"/></span>
                                    </strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <t t-call="web.internal_layout">
                    <h1 style="text-align: center;">
                        <b>Invoice</b>
                    </h1>

                    <table style="width: 100%; border: 1px solid #dee2e6; font-size: 11px; border-collapse: collapse;">
                        <tr>
                            <!-- LEFT BOX -->
                            <td style="width: 50%; vertical-align: top; border-right: 1px solid #dee2e6; padding: 6px;">
                                <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                    <tr>
                                        <td style="padding: 2px; width: 25%;">
                                            <strong>Customer</strong>
                                        </td>
                                        <td style="padding: 2px; width: 75%;">:
                                            <span t-out="o.partner_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Address</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-out="o.partner_id.city"/>
                                            <t t-if="o.partner_id.state_id">, <span t-out="o.partner_id.state_id.name"/></t>
                                            <t t-if="o.partner_id.country_id">, <span t-out="o.partner_id.country_id.name"/></t>
                                        </td>
                                    </tr>
                                    <tr t-if="o.partner_id.vat">
                                        <td style="padding: 2px;">
                                            <strong>VAT</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-out="o.partner_id.vat"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Shipper</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-out="o.consignor_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Consignee</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-out="o.consignee_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Port of Origin</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-out="o.port_of_loading_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Final Destination</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-out="o.port_of_discharge_id.name"/>
                                        </td>
                                    </tr>
                                    <t t-if="o.mode == 'air'">
                                        <tr>
                                            <td style="padding: 2px;">
                                                <strong>Carrier</strong>
                                            </td>
                                            <td style="padding: 2px;">:
                                                <span t-out="o.shipping_line.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 2px;">
                                                <strong>Flight #/Date</strong>
                                            </td>
                                            <td style="padding: 2px;">:
                                                <span t-out="o.flight_number_1"/>/
                                                <t t-if="o.flight_date_1"
                                                   t-out="o.flight_date_1.strftime('%d/%m/%Y')"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Cust. P/O No</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-out="o.customer_po_ref"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Shipper Ref. No</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-out="o.ref_num"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>ETD</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <t t-if="o.estimated_time_departure"
                                               t-out="o.estimated_time_departure.strftime('%d/%m/%Y')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>ETA</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <t t-if="o.eta_port_of_destination"
                                               t-out="o.eta_port_of_destination.strftime('%d/%m/%Y')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Note</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-field="o.remarks"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>

                            <!-- RIGHT BOX -->
                            <td style="width: 50%; vertical-align: top; padding: 6px;">
                                <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Invoice Number</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-out="o.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Date</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <t t-if="o.invoice_date" t-out="o.invoice_date.strftime('%d/%m/%Y')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Payment due date</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <t t-if="o.invoice_date_due"
                                               t-out="o.invoice_date_due.strftime('%d/%m/%Y')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Job Number</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-out="o.cargo_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Job Date</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <t t-if="o.date_order" t-out="o.date_order.strftime('%d/%m/%Y')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Bill of Lading No.</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <t t-if="o.mode == 'air'">
                                                <span t-out="o.mawb.awb_no"/>
                                            </t>
                                            <t t-elif="o.mode != 'air'">
                                                <span t-out="o.bill_of_lading_no"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>House Number</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-out="o.hawb"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Number of Packs</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-out="o.total_pieces"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Gross Weight (kgs)</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-field="o.total_gross_weight"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px;">
                                            <strong>Chargeable Weight (kgs)</strong>
                                        </td>
                                        <td style="padding: 2px;">:
                                            <span t-field="o.total_chargeable_weight"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- Invoice Table -->
                    <table class="table table-sm o_main_table"
                           style="width: 100%; border: 1px solid #dee2e6; margin-top: 15px; font-size: 11px; border-collapse: collapse;">
                        <thead>
                            <tr style="background-color: #104a8e; color: white; border: 1px solid #104a8e; text-align: center;">
                                <th style="padding: 6px; border: 1px solid #dee2e6; vertical-align: middle; color: white;"><b>الوصف</b><br/>DESCRIPTION</th>
                                <th style="padding: 6px; border: 1px solid #dee2e6; vertical-align: middle; color: white;"><b>الكمية</b><br/>QUANTITY</th>
                                <th style="padding: 6px; border: 1px solid #dee2e6; vertical-align: middle; color: white;"><b>سعر الوحدة</b><br/>UNIT PRICE</th>
                                <th style="padding: 6px; border: 1px solid #dee2e6; vertical-align: middle; color: white;"><b>نسبة الضريبة</b><br/>TAXES</th>
                                <th style="padding: 6px; border: 1px solid #dee2e6; vertical-align: middle; color: white;"><b>المجموع الفرعي بدون الضريبة</b><br/>SUBTOTAL<br/>(EXCLUSIVE OF VAT)</th>
                                <th style="padding: 6px; border: 1px solid #dee2e6; vertical-align: middle; color: white;"><b>قيمة الضريبة</b><br/>VAT<br/>AMOUNT</th>
                                <th style="padding: 6px; border: 1px solid #dee2e6; vertical-align: middle; color: white;"><b>المجموع شامل ضريبة القيمة المضافة</b><br/>SUBTOTAL<br/>(INCLUSIVE OF VAT)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr t-att-class="'fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''" style="border-bottom: 1px solid #dee2e6; vertical-align: top;">
                                    <t t-if="not line.display_type or line.display_type == 'product'">
                                        <td style="padding: 6px; border: 1px solid #dee2e6; text-align: left;">
                                            <span t-out="line.name"/>
                                        </td>
                                        <td style="padding: 6px; text-align: right; border: 1px solid #dee2e6;">
                                            <span t-out="'%.2f' % line.quantity"/>
                                        </td>
                                        <td style="padding: 6px; text-align: right; border: 1px solid #dee2e6;">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td style="padding: 6px; text-align: right; border: 1px solid #dee2e6;">
                                            <span t-out="', '.join(line.tax_ids.mapped('name'))"/>
                                        </td>
                                        <td style="padding: 6px; text-align: right; border: 1px solid #dee2e6;">
                                            <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td style="padding: 6px; text-align: right; border: 1px solid #dee2e6;">
                                            <span t-out="line.price_total - line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td style="padding: 6px; text-align: right; border: 1px solid #dee2e6;">
                                            <span t-field="line.price_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td colspan="7" style="padding: 6px; border: 1px solid #dee2e6; text-align: left;">
                                            <span t-out="line.name"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div style="margin-top: 10px; padding-top: 10px;">
                        <p style="text-align: left;">
                            <strong>
                                <span t-out="o.company_currency_id.amount_to_text(o.amount_total)"/>
                            </strong>
                        </p>

                        <!-- Two-column layout: Summary table on right (which appears on left in RTL) -->
                        <div style="width: 100%; display: table; margin-top: 10px;">
                            <!-- Left column: Spacer -->
                            <div style="display: table-cell; width: 40%; vertical-align: top;">
                            </div>

                            <!-- Right column: Summary table -->
                            <div style="display: table-cell; width: 60%; vertical-align: top;">
                                <table style="width: 100%; border-collapse: collapse; font-size: 11px; border: 1px solid #dee2e6;">
                                    <tr>
                                        <td style="padding: 6px; border: 1px solid #dee2e6; text-align: right; font-weight: bold; width: 65%;">
                                            Invoice Taxable Amount /<br/>المبلغ الخاضع للضريبة غير شامل ضريبة القيمة المضافة
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #dee2e6; text-align: right; width: 35%;">
                                            <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 6px; border: 1px solid #dee2e6; text-align: right; font-weight: bold;">
                                            VAT Taxes
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #dee2e6; text-align: right;">
                                            <span t-out="o.amount_total - o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #104a8e; color: white;">
                                        <td style="padding: 6px; border: 1px solid #104a8e; text-align: right; font-weight: bold; color: white;">
                                            Invoice Total (inclusive of VAT) / إجمالي قيمة الفاتورة شامل ضريبة القيمة المضافة
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #104a8e; text-align: right; color: white;">
                                            <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div style="margin-top:30px; width:100%; font-size:12px; display:table;">
                        <!-- Left: Terms -->
                        <div style="display:table-cell; width:60%; vertical-align:top;">
                            <strong>Terms:</strong>
                            <div style="margin-top: 5px; min-height: 50px;">
                                <span t-field="o.narration"/>
                            </div>
                            <p style="margin-top: 10px;">E.&amp;O.E</p>
                            <p style="font-size:11px;">This is a computer-generated document and does not
                                require a signature or stamp.
                            </p>
                        </div>

                        <!-- Right: Bank Details -->
                        <t t-if="o.partner_bank_id">
                            <div style="display:table-cell; width:35%; padding-left: 20px; vertical-align:top;">
                                <li>All payments via Bank Transfer, please remit to the following Bank Account
                                    details:
                                </li>
                                <div style="border: 1px solid #000; padding: 10px; border-radius: 10px;">
                                    <strong>Bank Details</strong>
                                    <br/>
                                    <t t-if="o.partner_bank_id">
                                        A/C Name:
                                        <t t-out="o.partner_bank_id.acc_holder_name"/>
                                        <br/>
                                        Bank Name:
                                        <t t-out="o.partner_bank_id.bank_id.name"/>
                                        <br/>
                                        A/C No:
                                        <t t-out="o.partner_bank_id.acc_number"/>
                                        <br/>
                                        IBAN No:
                                        <t t-out="o.partner_bank_id.bank_id.iban"/>
                                        <br/>
                                        Swift Code:
                                        <t t-out="o.partner_bank_id.bank_id.swift_code"/>
                                        <br/>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div class="footer">
                        <div class="text-center">
                            <table class="my-0 table table-sm table-borderless">
                                <tr width="100%">
                                    <td align="center">
                                    </td>
                                </tr>
                                <tr width="100%">
                                    <td align="right">
                                        Page
                                        <span class="page"/>
                                        /
                                        <span class="topage"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="ff_invoice_action" model="ir.actions.report">
        <field name="name">FF Invoice</field>
        <field name="model">account.move</field>
        <field name="report_name">verts_v15_freight_forward.report_invoice_document_ff_invoice</field>
        <field name="report_file">verts_v15_freight_forward.report_invoice_document_ff_invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="binding_model_id" ref="verts_v15_freight_forward.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>