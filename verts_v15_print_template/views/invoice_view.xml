<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <data>
    <!-- Inherited Customer For add Reporting Field -->
    <record model="ir.ui.view" id="view_report_company_invoice_customer_template">
      <field name="name">account.move.customer.form.inherit</field>
      <field name="inherit_id" ref="account.view_move_form"/>
      <field name="model">account.move</field>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='user_id']" position="after">
          <field name="report_template_id1" invisible="1"/>
          <field name="report_template_id" invisible="1" domain="[('report_name', 'ilike', '%invoice_template%'')]" options="{'no_create': True}"/>
        </xpath>
      </field>
    </record>
    <record model="ir.ui.view" id="view_report_company_invoice_supplier_template">
      <field name="name">account.move.supplier.form.inherit</field>
      <field name="inherit_id" ref="account.view_move_form"/>
      <field name="model">account.move</field>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='date_due']" position="after">
          <field name="report_template_id" invisible="1" domain="[('report_name', 'ilike', '%invoice_template%'')]" options="{'no_create': True}"/>
          <field name="report_template_id1" invisible="1"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
