<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="verts_v15_print_template.FieldColor" owl="1">
        <span t-att-class="props.widgetClass" t-att-style="props.node?.attrs?.style">
            <input type="text"
                   t-if="!props.readonly"
                   t-att-value="value or ''"
                   class="color {hash:true}"
                   t-on-change="onChange"/>
            <div t-if="props.readonly"/>
            <span t-if="props.readonly" class="oe_form_char_content" t-out="value or ''"/>
        </span>
    </t>
</templates>
