<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_template_form_inherit_commission" model="ir.ui.view">
        <field name="name">product.template.form.inherit.commission</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
           <!--  <xpath expr="//field[@name='name']" position="after">
                <field name="is_commission_applicable"/>
            </xpath>
 -->
            <xpath expr="//div[@name='options']" position="inside">
                    <div>
                        <field name="is_commission_applicable"/>
                        <label for="is_commission_applicable"/>
                    </div>
                </xpath>
        </field>
    </record>

    <record id="view_product_product_form_inherit_commission" model="ir.ui.view">
        <field name="name">product.product.form.inherit.commission</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="is_commission_applicable"/>
            </xpath>
        </field>
    </record>
</odoo>
