<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="view_inbound_flight_form" model="ir.ui.view">
    <field name="name">inbound.flight.form</field>
    <field name="model">inbound.flight</field>
    <field name="arch" type="xml">
      <form string="Inbound Flight">
        <header>
          <button name="action_create_invoice" string="Create Invoice" type="object" groups="verts_v15_airport_operation.group_invoice_creator" class="oe_highlight"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" readonly="1"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="location" invisible="true"/>
              <field name="date"/>
              <field name="loaded" invisible="1"/>
              <field name="type" invisible="true"/>
              <field name="airline_id"/>
              <field name="trx_type"/>
              <field name="manifest"/>
            </group>
            <group>
              <field name="gross_wt"/>
              <field name="chrg_wt"/>
              <label for="route" string="Route"/>
              <div class="o_row">
                <field name="route" class="oe_inline" readonly="0"/>
                <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow"/>
                <field name="route2" class="oe_inline" readonly="0"/>
              </div>
              <!-- <field name="route"/>
                            <field name="route2"/> -->
              <field name="flt_date"/>
              <field name="arr_date"/>
              <field name="flt"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <!-- Tree View for Inbound Flight -->
  <record id="view_inbound_flight_tree" model="ir.ui.view">
    <field name="name">inbound.flight.tree</field>
    <field name="model">inbound.flight</field>
    <field name="arch" type="xml">
      <list string="Inbound Flight">
        <field name="name"/>
        <field name="date"/>
        <field name="trx_type"/>
        <field name="airline_id"/>
        <field name="manifest"/>
      </list>
    </field>
  </record>
  <record id="action_inbound_flight" model="ir.actions.act_window">
    <field name="name">Flight Operation</field>
    <field name="res_model">inbound.flight</field>
    <field name="view_mode">list,form</field>
    <field name="context">{}</field>
  </record>
</odoo>
