<odoo>
    <data noupdate="1">
        <record id="seq_inbound_flight" model="ir.sequence">
            <field name="name">Inbound Flight Sequence</field>
            <field name="code">inbound.flight</field>
            <field name="prefix">FL</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

         <record id="seq_gsa_invoice" model="ir.sequence">
            <field name="name">GSA Invoice</field>
            <field name="code">gsa.invoice</field>
            <field name="prefix">INV</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

          <record id="seq_cv_csr_report" model="ir.sequence">
            <field name="name">CV CSR Report</field>
            <field name="code">cv.csr.report</field>
            <field name="prefix">CSR</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
