<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <data>
    <record id="res_users_view_form_inherit_inherit12" model="ir.ui.view">
      <field name="name">res.users.form.inherit</field>
      <field name="model">res.users</field>
      <field name="inherit_id" ref="base.view_users_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div/group/field[@name='partner_id']" position="after">
          <field name="is_director"/>
        </xpath>
        <xpath expr="//page[@name='access_rights']//group" position="after">
          <group string="Multi Branches">
            <field name="branch_ids" widget="many2many_tags" options="{'no_create': True}" groups="verts_v15_basic_masters.group_multi_branches"/>
            <field name="branch_id" options="{'no_create': True}" groups="verts_v15_basic_masters.group_multi_branches"/>
          </group>
        </xpath>
        <xpath expr="//field[@name='partner_id']" position="after">
          <!--					<field name="branch_ids" widget="many2many_tags" options="{'no_create': True}" />-->
        </xpath>
        <xpath expr="//field[@name='signature']" position="after">
          <field name="digital_signature_type"/>
          <label for="digital_signature" invisible="digital_signature_type != 'draw'" string="Draw Digital Signature" class="oe_edit_only"/>
          <h2>
            <field name="digital_signature" string="Draw Digital Signature" invisible="digital_signature_type != 'draw'" widget="signature"/>
          </h2>
          <field name="digital_signature_upload" class="oe_left oe_avatar" widget="image" invisible="digital_signature_type != 'image_upload'"/>
        </xpath>
      </field>
    </record>
    <record id="inherited_res_users_preferences_form" model="ir.ui.view">
      <field name="name">inherited.res.users.preferences.form</field>
      <field name="model">res.users</field>
      <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='signature']" position="after">
          <field name="digital_signature_type"/>
          <label for="digital_signature" string="Draw Digital Signature" invisible="digital_signature_type != 'draw'" class="oe_edit_only"/>
          <h2>
            <field name="digital_signature" string="Draw Digital Signature" invisible="digital_signature_type != 'draw'" widget="signature"/>
          </h2>
          <field name="digital_signature_upload" class="oe_left oe_avatar" widget="image" invisible="digital_signature_type != 'image_upload'"/>
        </xpath>
      </field>
    </record>
