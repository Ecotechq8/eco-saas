<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_sync_data" model="ir.cron">
        <field name="name">Sync: Import data foodics to odoo</field>
        <field name="model_id" eval="env['ir.model'].search([('model', '=', 'foodic.connector')]).id"/>
        <field name="state">code</field>
        <field name="code">model.sync_all_data()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>