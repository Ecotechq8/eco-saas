<odoo>

    <record id="foodics_history_view_list" model="ir.ui.view">
        <field name="name">foodics.history.view.list</field>
        <field name="model">foodics.history</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="date_time"/>
                <field name="user_id"/>
                <field name="req_url"/>
            </list>
        </field>
    </record>

    <record id="foodics_history_view_form" model="ir.ui.view">
        <field name="name">foodics_history_view_form</field>
        <field name="model">foodics.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="date_time"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="req_url"/>
                        </group>
                    </group>
                    <notebook>
                         <page string="Response">
                            <field name="response"/>
                        </page>
                        <page string="Request Data">
                            <field name="req_data"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="foodics_history_action" model="ir.actions.act_window">
        <field name="name">Foodics History</field>
        <field name="res_model">foodics.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="foodic_history"
              name="Foodics History"
              parent="menu_connector"
              action="foodics_history_action"
              sequence="1"/>
</odoo>