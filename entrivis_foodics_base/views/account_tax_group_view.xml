<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sync_account_tax_group_form" model="ir.ui.view">
            <field name="name">sync.account.tax.group.form</field>
            <field name="model">account.tax.group</field>
            <field name="inherit_id" ref="account.view_tax_group_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet" position="before">
                    <header>
                        <button class="oe_highlight" name="sync_specific_tax_group" string="Sync Tax Group" type="object"/>
                    </header>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="foodics_id" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="action_sync_account_tax_group" model="ir.actions.server">
            <field name="name">Sync Account Tax Group</field>
            <field name="model_id" ref="model_account_tax_group"/>
            <field name="binding_model_id" ref="account.model_account_tax_group"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                action = records.sync_all_tax_group()
            </field>
        </record>
    </data>
</odoo>
