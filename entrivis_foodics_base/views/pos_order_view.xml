<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="pos_order_form_view_foodics" model="ir.ui.view">
        <field name="name">pos.order.form.view.foodics</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="foodics" string="Foodics">
                    <group>
                        <field name="foodics_id" readonly="1"/>
                    </group>
                    <button name="sync_single_orders" string="Sync Order" type="object"/>
                </page>
            </xpath>
            <xpath expr="//field[@name='lines']/list/field[@name='discount']" position="after">
                <field name="discount_amount" readonly="1"/>
                <field name="discount_type" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='lines']/list/field[@name='pack_lot_ids']" position="before">
                <field name="modifier_of" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='lines']/list/field[@name='discount']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='lines']" position="after">
                <label for="global_discount"/>
                <field name="global_discount"
                       force_save="1"
                       readonly="1"
                       widget="monetary"/>
            </xpath>
            <xpath expr="//field[@name='amount_tax']" position="before">
                <field name="discount_amount"
                       force_save="1"
                       readonly="1"
                       widget="monetary"/>
            </xpath>
        </field>
    </record>

    <record id="pos_inherit_search_view" model="ir.ui.view">
        <field name="name">pos.order.inherit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <search>
                <field name="foodics_id"/>
                <separator/>
                <filter string='Foodics Orders' name='foodics_id' domain="[('foodics_id', '!=', False)]"/>
            </search>
        </field>
    </record>
</odoo>