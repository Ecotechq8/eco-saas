<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="product_normal_form_view_foodics" model="ir.ui.view">
        <field name="name">product.normal.form.view.foodics</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="foodics" string="Foodics">
                    <group>
                        <group>
                            <field name="foodics_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="selling_method"/>
                            <field name="pricing_method"/>
                            <field name="costing_method"/>
                        </group>
                    </group>
                    <button name="sync_single_products" string="Sync Product" type="object"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_inherit_form" model="ir.ui.view">
        <field name="name">product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="is_sync_with_foodics"/>
                    <label for="is_sync_with_foodics"/>
                </span>
                <span class="d-inline-block">
                    <field name="is_modifiers"/>
                    <label for="is_modifiers"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>