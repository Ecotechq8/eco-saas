<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sync_product_category_form" model="ir.ui.view">
            <field name="name">sync.product.category.form</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet" position="before">
                    <header>
                        <button class="oe_highlight" name="sync_specific_category" string="Sync Product" type="object"/>
                    </header>
                </xpath>
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="foodics_id" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="action_sync_product_category" model="ir.actions.server">
            <field name="name">Sync Product Category</field>
            <field name="model_id" ref="model_product_category"/>
            <field name="binding_model_id" ref="product.model_product_category"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                action = records.sync_all_category()
            </field>
        </record>
    </data>
</odoo>
